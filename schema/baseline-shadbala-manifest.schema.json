{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/teispace/teistro-conformance/schema/baseline-shadbala-manifest.schema.json",
  "title": "The manifest of the Shadbala corpus",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "provenance",
    "naisargika",
    "minimum_rupas",
    "saptavargaja_vargas",
    "files",
    "counts"
  ],
  "properties": {
    "schema": {
      "const": "teistro-conformance/baseline-shadbala-manifest/1"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "evidence_rank",
        "engine_version",
        "exporter_version"
      ],
      "properties": {
        "source": {
          "type": "string"
        },
        "evidence_rank": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "engine_version": {
          "type": "string"
        },
        "exporter_version": {
          "type": "string"
        }
      }
    },
    "naisargika": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "SUN",
        "MOON",
        "MARS",
        "MERCURY",
        "JUPITER",
        "VENUS",
        "SATURN"
      ],
      "properties": {
        "SUN": {
          "type": "number",
          "minimum": 0,
          "maximum": 60
        },
        "MOON": {
          "type": "number",
          "minimum": 0,
          "maximum": 60
        },
        "MARS": {
          "type": "number",
          "minimum": 0,
          "maximum": 60
        },
        "MERCURY": {
          "type": "number",
          "minimum": 0,
          "maximum": 60
        },
        "JUPITER": {
          "type": "number",
          "minimum": 0,
          "maximum": 60
        },
        "VENUS": {
          "type": "number",
          "minimum": 0,
          "maximum": 60
        },
        "SATURN": {
          "type": "number",
          "minimum": 0,
          "maximum": 60
        }
      }
    },
    "minimum_rupas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "SUN",
        "MOON",
        "MARS",
        "MERCURY",
        "JUPITER",
        "VENUS",
        "SATURN"
      ],
      "properties": {
        "SUN": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "MOON": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "MARS": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "MERCURY": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "JUPITER": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "VENUS": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "SATURN": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "saptavargaja_vargas": {
      "type": "array",
      "items": {
        "enum": [
          "D1",
          "D2",
          "D3",
          "D7",
          "D9",
          "D12",
          "D30"
        ]
      },
      "minItems": 7,
      "maxItems": 7,
      "uniqueItems": true
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "file",
          "fixture",
          "sha256"
        ],
        "properties": {
          "file": {
            "type": "string"
          },
          "fixture": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "files"
      ],
      "properties": {
        "files": {
          "type": "integer"
        }
      }
    }
  }
}
