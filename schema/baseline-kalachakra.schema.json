{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/teispace/teistro-conformance/schema/baseline-kalachakra.schema.json",
  "title": "The Kalachakra dasha of one baseline fixture",
  "description": "The engine's Kalachakra dasha, computed from the recorded Moon, birth instant and nakshatra span of the fixture it names, under each balance method the fixture records. The rule data is in the directory's manifest.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "fixture",
    "provenance",
    "year_length_days",
    "moon_sidereal_longitude_deg",
    "nakshatra_index",
    "pada_index",
    "reference_instants_jd",
    "methods"
  ],
  "properties": {
    "schema": {
      "const": "teistro-conformance/baseline-kalachakra/1"
    },
    "fixture": {
      "type": "string",
      "pattern": "^(charts|variants)/[^/]+\\.json$"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "evidence_rank",
        "engine_version",
        "exporter_version",
        "inputs"
      ],
      "properties": {
        "source": {
          "type": "string"
        },
        "evidence_rank": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "engine_version": {
          "type": "string"
        },
        "exporter_version": {
          "type": "string"
        },
        "inputs": {
          "type": "string"
        }
      }
    },
    "year_length_days": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "moon_sidereal_longitude_deg": {
      "type": "number",
      "minimum": 0,
      "exclusiveMaximum": 360
    },
    "nakshatra_index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 26
    },
    "pada_index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3,
      "description": "The pada within the nakshatra, from 0."
    },
    "reference_instants_jd": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 1
    },
    "methods": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "spatial": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "balance",
            "tree_depth",
            "row_format",
            "periods",
            "chain_depth",
            "chain_format",
            "active_at"
          ],
          "properties": {
            "balance": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "years",
                "months",
                "days",
                "hours",
                "minutes",
                "total_days"
              ],
              "properties": {
                "years": {
                  "type": "integer",
                  "minimum": 0
                },
                "months": {
                  "type": "integer",
                  "minimum": 0
                },
                "days": {
                  "type": "integer",
                  "minimum": 0
                },
                "hours": {
                  "type": "integer",
                  "minimum": 0
                },
                "minutes": {
                  "type": "integer",
                  "minimum": 0
                },
                "total_days": {
                  "type": "number",
                  "minimum": 0
                }
              }
            },
            "tree_depth": {
              "type": "integer",
              "minimum": 1
            },
            "row_format": {
              "const": [
                "path",
                "sign_index",
                "lord",
                "start_jd",
                "end_jd"
              ]
            },
            "periods": {
              "type": "array",
              "items": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "string",
                    "pattern": "^[0-9]+(/[0-9]+)*$"
                  },
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 11
                  },
                  {
                    "type": "string",
                    "enum": [
                      "SUN",
                      "MOON",
                      "MARS",
                      "MERCURY",
                      "JUPITER",
                      "VENUS",
                      "SATURN",
                      "RAHU",
                      "KETU"
                    ]
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "items": false,
                "minItems": 5
              }
            },
            "chain_depth": {
              "type": "integer",
              "minimum": 1
            },
            "chain_format": {
              "const": [
                "level",
                "index",
                "sign_index",
                "lord",
                "start_jd",
                "end_jd"
              ]
            },
            "active_at": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "jd",
                  "chain"
                ],
                "properties": {
                  "jd": {
                    "type": "number"
                  },
                  "chain": {
                    "type": "array",
                    "items": {
                      "type": "array",
                      "prefixItems": [
                        {
                          "type": "integer",
                          "minimum": 1
                        },
                        {
                          "type": "integer",
                          "minimum": 0
                        },
                        {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 11
                        },
                        {
                          "type": "string",
                          "enum": [
                            "SUN",
                            "MOON",
                            "MARS",
                            "MERCURY",
                            "JUPITER",
                            "VENUS",
                            "SATURN",
                            "RAHU",
                            "KETU"
                          ]
                        },
                        {
                          "type": "number"
                        },
                        {
                          "type": "number"
                        }
                      ],
                      "items": false,
                      "minItems": 6
                    }
                  }
                }
              }
            }
          }
        },
        "temporal": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "balance",
            "tree_depth",
            "row_format",
            "periods",
            "chain_depth",
            "chain_format",
            "active_at"
          ],
          "properties": {
            "balance": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "years",
                "months",
                "days",
                "hours",
                "minutes",
                "total_days"
              ],
              "properties": {
                "years": {
                  "type": "integer",
                  "minimum": 0
                },
                "months": {
                  "type": "integer",
                  "minimum": 0
                },
                "days": {
                  "type": "integer",
                  "minimum": 0
                },
                "hours": {
                  "type": "integer",
                  "minimum": 0
                },
                "minutes": {
                  "type": "integer",
                  "minimum": 0
                },
                "total_days": {
                  "type": "number",
                  "minimum": 0
                }
              }
            },
            "tree_depth": {
              "type": "integer",
              "minimum": 1
            },
            "row_format": {
              "const": [
                "path",
                "sign_index",
                "lord",
                "start_jd",
                "end_jd"
              ]
            },
            "periods": {
              "type": "array",
              "items": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "string",
                    "pattern": "^[0-9]+(/[0-9]+)*$"
                  },
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 11
                  },
                  {
                    "type": "string",
                    "enum": [
                      "SUN",
                      "MOON",
                      "MARS",
                      "MERCURY",
                      "JUPITER",
                      "VENUS",
                      "SATURN",
                      "RAHU",
                      "KETU"
                    ]
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "items": false,
                "minItems": 5
              }
            },
            "chain_depth": {
              "type": "integer",
              "minimum": 1
            },
            "chain_format": {
              "const": [
                "level",
                "index",
                "sign_index",
                "lord",
                "start_jd",
                "end_jd"
              ]
            },
            "active_at": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "jd",
                  "chain"
                ],
                "properties": {
                  "jd": {
                    "type": "number"
                  },
                  "chain": {
                    "type": "array",
                    "items": {
                      "type": "array",
                      "prefixItems": [
                        {
                          "type": "integer",
                          "minimum": 1
                        },
                        {
                          "type": "integer",
                          "minimum": 0
                        },
                        {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 11
                        },
                        {
                          "type": "string",
                          "enum": [
                            "SUN",
                            "MOON",
                            "MARS",
                            "MERCURY",
                            "JUPITER",
                            "VENUS",
                            "SATURN",
                            "RAHU",
                            "KETU"
                          ]
                        },
                        {
                          "type": "number"
                        },
                        {
                          "type": "number"
                        }
                      ],
                      "items": false,
                      "minItems": 6
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
