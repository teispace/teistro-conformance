{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/teispace/teistro-conformance/schema/baseline-ashtakavarga-manifest.schema.json",
  "title": "The manifest of the Ashtakavarga corpus",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "provenance",
    "methods",
    "files",
    "counts"
  ],
  "properties": {
    "schema": {
      "const": "teistro-conformance/baseline-ashtakavarga-manifest/1"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "evidence_rank",
        "engine_version",
        "exporter_version"
      ],
      "properties": {
        "source": {
          "type": "string"
        },
        "evidence_rank": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "engine_version": {
          "type": "string"
        },
        "exporter_version": {
          "type": "string"
        }
      }
    },
    "methods": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "file",
          "fixture",
          "sha256"
        ],
        "properties": {
          "file": {
            "type": "string"
          },
          "fixture": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "files"
      ],
      "properties": {
        "files": {
          "type": "integer"
        }
      }
    }
  }
}
