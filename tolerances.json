    "foundation.*_day.*_jd": { "unit": "day", "same-ephemeris": 2e-5, "de": 2e-5, "reference": 2e-5, "builtin-full": 5e-5, "builtin-standard": 1e-4, "builtin-compact": 5e-4 },
    "foundation.panchanga_day.arc_*_jd": { "unit": "day", "same-ephemeris": 2e-5, "de": 2e-5, "reference": 2e-5, "builtin-full": 5e-5, "builtin-standard": 1e-4, "builtin-compact": 5e-4 },
    "foundation.upagrahas.*.sidereal_longitude_deg": { "unit": "deg", "same-ephemeris": 1e-5, "de": 1e-5, "reference": 1e-5, "builtin-full": 1e-3, "builtin-standard": 3e-3, "builtin-compact": 3e-2 },
    "foundation.birth_timing.*": { "unit": "day", "same-ephemeris": 2e-5, "de": 2e-5, "reference": 2e-5, "builtin-full": 5e-5, "builtin-standard": 1e-4, "builtin-compact": 5e-4 },
    "houses.*.cusps": { "unit": "deg", "same-ephemeris": 1e-6, "de": 1e-5, "reference": 1e-5, "builtin-full": 1e-4, "builtin-standard": 1e-4, "builtin-compact": 1e-4 },
    "houses.*.ascendant": { "unit": "deg", "same-ephemeris": 1e-6, "de": 1e-5, "reference": 1e-5, "builtin-full": 1e-4, "builtin-standard": 1e-4, "builtin-compact": 1e-4 },
    "houses.*.mc": { "unit": "deg", "same-ephemeris": 1e-6, "de": 1e-5, "reference": 1e-5, "builtin-full": 1e-4, "builtin-standard": 1e-4, "builtin-compact": 1e-4 },
    "houses.bhava_chalit.bhava_*": { "unit": "deg", "same-ephemeris": 1e-6, "de": 1e-5, "reference": 1e-5, "builtin-full": 1e-4, "builtin-standard": 1e-4, "builtin-compact": 1e-4 },
    "houses.special_lagnas.*_deg": { "unit": "deg", "same-ephemeris": 1e-5, "de": 1e-5, "reference": 1e-5, "builtin-full": 1e-3, "builtin-standard": 3e-3, "builtin-compact": 3e-2 },
    "panchanga.*_longitude_deg": { "unit": "deg", "same-ephemeris": 1e-6, "de": 1e-6, "reference": 2e-6, "builtin-full": 3e-4, "builtin-standard": 1e-3, "builtin-compact": 1e-2 },
    "panchanga_day.*.start_jd": { "unit": "day", "same-ephemeris": 1e-5, "de": 1e-5, "reference": 1e-5, "builtin-full": 3e-4, "builtin-standard": 1e-3, "builtin-compact": 1e-2 },
    "panchanga_day.*.end_jd": { "unit": "day", "same-ephemeris": 1e-5, "de": 1e-5, "reference": 1e-5, "builtin-full": 3e-4, "builtin-standard": 1e-3, "builtin-compact": 1e-2 },
    "panchanga_day.*_jd": { "unit": "day", "same-ephemeris": 2e-5, "de": 2e-5, "reference": 2e-5, "builtin-full": 5e-5, "builtin-standard": 1e-4, "builtin-compact": 5e-4 },
    "dashas.moon_nakshatra_elapsed_fraction": { "unit": "ratio", "same-ephemeris": 1e-7, "de": 1e-7, "reference": 2e-7, "builtin-full": 3e-5, "builtin-standard": 1e-4, "builtin-compact": 1e-3 },
    "dashas.methods.spatial.remaining_fraction": { "unit": "ratio", "same-ephemeris": 1e-7, "de": 1e-7, "reference": 2e-7, "builtin-full": 3e-5, "builtin-standard": 1e-4, "builtin-compact": 1e-3 },
    "dashas.methods.temporal.remaining_fraction": { "unit": "ratio", "same-ephemeris": 1e-5, "de": 1e-5, "reference": 1e-5, "builtin-full": 3e-4, "builtin-standard": 1e-3, "builtin-compact": 1e-2 },
    "dashas.methods.temporal.nakshatra_span.*": { "unit": "day", "same-ephemeris": 1e-5, "de": 1e-5, "reference": 1e-5, "builtin-full": 3e-4, "builtin-standard": 1e-3, "builtin-compact": 1e-2 },
    "dashas.methods.*.balance.total_days": { "unit": "day", "same-ephemeris": 1e-3, "de": 1e-3, "reference": 1e-3, "builtin-full": 0.3, "builtin-standard": 1.0, "builtin-compact": 10.0 },
    "dashas.methods.*.periods[*][2..3]": { "unit": "day", "same-ephemeris": 1e-3, "de": 1e-3, "reference": 1e-3, "builtin-full": 0.3, "builtin-standard": 1.0, "builtin-compact": 10.0 },
    "dashas.methods.*.children_at_path.*[*][2..3]": { "unit": "day", "same-ephemeris": 1e-3, "de": 1e-3, "reference": 1e-3, "builtin-full": 0.3, "builtin-standard": 1.0, "builtin-compact": 10.0 },
    "dashas.methods.*.active_at[*].chain[*].*_jd": { "unit": "day", "same-ephemeris": 1e-3, "de": 1e-3, "reference": 1e-3, "builtin-full": 0.3, "builtin-standard": 1.0, "builtin-compact": 10.0 }
  }
