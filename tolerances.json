{
  "schema": "teistro-conformance/tolerances/1",
  "status": "provisional",
  "note": "The one central tolerance file (ADR-0022): keyed by field pattern and provider class, never per fixture. Provisional until the harness exists and the bands are measured; every change is a corpus version bump. A field not listed is compared exactly.",
  "provider_classes": {
    "same-ephemeris": "the SDK over an adapter to the same ephemeris library and data files the fixture was produced with (Swiss Ephemeris, or Teimeris in its compatible profile)",
    "de": "the SDK over a JPL DE file reader (ADR-0021), target 0.001 arcsecond",
    "reference": "the built-in reference tier, a DE440 refit (ADR-0021), target 0.005 arcsecond for the Sun, Moon and inner planets and 0.02 arcsecond for the outer planets",
    "builtin-full": "the built-in analytic ephemeris, full tier (ADR-0008), about an arcsecond",
    "builtin-standard": "the built-in analytic ephemeris, standard tier (the default), a few arcseconds",
    "builtin-compact": "the built-in analytic ephemeris, compact tier, tens of arcseconds"
  },
  "units": {
    "deg": "degrees of arc",
    "deg_per_day": "degrees of arc per day",
    "au": "astronomical units",
    "day": "days (a Julian Day difference); 1e-5 day is 0.864 seconds"
  },
  "edge_policy": "A classification field (sign, nakshatra, pada, house, tithi, yoga, karana, dasha lord) must match exactly, except when the angle it derives from lies within the longitude tolerance of the class of a classification boundary; then a mismatch is reported as an edge case, not a failure, and the fixture's `input.search` block says when the edge is deliberate.",
  "fields": {
    "positions.bodies.*.sidereal_longitude_deg": { "unit": "deg", "same-ephemeris": 1e-6, "de": 1e-6, "reference": 2e-6, "builtin-full": 3e-4, "builtin-standard": 1e-3, "builtin-compact": 1e-2 },
    "positions.bodies.*.tropical_longitude_deg": { "unit": "deg", "same-ephemeris": 1e-6, "de": 1e-6, "reference": 2e-6, "builtin-full": 3e-4, "builtin-standard": 1e-3, "builtin-compact": 1e-2 },
    "positions.bodies.*.latitude_deg": { "unit": "deg", "same-ephemeris": 1e-6, "de": 1e-6, "reference": 2e-6, "builtin-full": 3e-4, "builtin-standard": 1e-3, "builtin-compact": 1e-2 },
    "positions.bodies.*.speed_deg_per_day": { "unit": "deg_per_day", "same-ephemeris": 1e-6, "de": 1e-5, "reference": 1e-5, "builtin-full": 1e-4, "builtin-standard": 1e-3, "builtin-compact": 1e-2 },
    "positions.bodies.*.distance_au": { "unit": "au", "same-ephemeris": 1e-9, "de": 1e-8, "reference": 1e-8, "builtin-full": 1e-6, "builtin-standard": 1e-5, "builtin-compact": 1e-4 },
    "positions.bodies.*.degrees_from_sun": { "unit": "deg", "same-ephemeris": 2e-6, "de": 2e-6, "reference": 4e-6, "builtin-full": 6e-4, "builtin-standard": 2e-3, "builtin-compact": 2e-2 },
    "positions.outer.*.sidereal_longitude_deg": { "unit": "deg", "same-ephemeris": 1e-6, "de": 1e-6, "reference": 6e-6, "builtin-full": 1e-3, "builtin-standard": 3e-3, "builtin-compact": 3e-2 },
    "foundation.ayanamsha.value_deg": { "unit": "deg", "same-ephemeris": 1e-7, "de": 1e-6, "reference": 1e-6, "builtin-full": 1e-6, "builtin-standard": 1e-6, "builtin-compact": 1e-6 },
    "foundation.delta_t_days": { "unit": "day", "same-ephemeris": 1e-9, "de": 1e-7, "reference": 1e-7, "builtin-full": 1e-7, "builtin-standard": 1e-7, "builtin-compact": 1e-7 },
    "foundation.lagna.sidereal_longitude_deg": { "unit": "deg", "same-ephemeris": 1e-6, "de": 1e-5, "reference": 1e-5, "builtin-full": 1e-4, "builtin-standard": 1e-4, "builtin-compact": 1e-4 },
